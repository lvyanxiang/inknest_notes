# Docker Compose development settings. Copy to .env to override defaults.
POSTGRES_DB=inknest
POSTGRES_USER=inknest
POSTGRES_PASSWORD=inknest-postgres-dev
POSTGRES_PORT=5432

MINIO_ROOT_USER=inknest-minio
MINIO_ROOT_PASSWORD=inknest-minio-dev
MINIO_BUCKET=inknest-private
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# The hostname:port embedded in signed URLs returned to the App.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_SECURE=false
MINIO_REGION=us-east-1

API_PORT=8000
INKNEST_JWT_SECRET=replace-with-at-least-32-random-characters
