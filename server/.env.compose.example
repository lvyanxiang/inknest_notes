# Optional non-secret API overrides for the Compose API container.
# Copy to server/.env.compose only when overriding application defaults.
INKNEST_ENVIRONMENT=development
INKNEST_LOG_LEVEL=INFO
INKNEST_ACCESS_TOKEN_MINUTES=15
INKNEST_REFRESH_TOKEN_DAYS=30
INKNEST_LOGIN_RATE_LIMIT_ACCOUNT_ATTEMPTS=5
INKNEST_LOGIN_RATE_LIMIT_IP_ATTEMPTS=25
INKNEST_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
INKNEST_ASSET_UPLOAD_URL_MINUTES=15
INKNEST_ASSET_UPLOAD_SESSION_HOURS=24
INKNEST_MAX_ASSET_UPLOAD_BYTES=536870912
