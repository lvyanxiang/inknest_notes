# =============================================================================
# 1. 应用运行环境
# =============================================================================
# 可选值：development、test、production。
INKNEST_ENVIRONMENT=development

# Python 服务日志级别，常用值：DEBUG、INFO、WARNING、ERROR。
INKNEST_LOG_LEVEL=INFO


# =============================================================================
# 2. PostgreSQL 数据库
# =============================================================================
# FastAPI 在宿主机运行时使用 localhost；API 在 Compose 容器内运行时使用 postgres。
# 格式：postgresql+psycopg://用户名:密码@主机:端口/数据库名
INKNEST_DATABASE_URL=postgresql+psycopg://inknest:inknest-postgres-dev@localhost:5432/inknest


# =============================================================================
# 3. MinIO 对象存储
# =============================================================================
# API 服务访问 MinIO 的内部地址。宿主机开发使用 localhost:9000。
INKNEST_MINIO_ENDPOINT=localhost:9000

# App 上传或下载附件时可访问的地址。实体设备调试时应改为 Mac 的局域网 IP，例如 192.168.x.x:9000。
INKNEST_MINIO_PUBLIC_ENDPOINT=localhost:9000

# MinIO 访问凭证。开发环境需与根目录 .env 中的 MINIO_ROOT_USER / MINIO_ROOT_PASSWORD 一致。
INKNEST_MINIO_ACCESS_KEY=inknest-minio
INKNEST_MINIO_SECRET_KEY=inknest-minio-dev

# 内部连接和客户端公开连接是否使用 HTTPS；本地开发通常都是 false。
INKNEST_MINIO_SECURE=false
INKNEST_MINIO_PUBLIC_SECURE=false

# S3 兼容区域名；本地 MinIO 通常保持默认值即可。
INKNEST_MINIO_REGION=us-east-1

# 附件 Bucket 名称，必须与根目录 .env 中的 MINIO_BUCKET 一致。
INKNEST_MINIO_BUCKET=inknest-private


# =============================================================================
# 4. 附件传输限制
# =============================================================================
# 预签名上传地址的有效分钟数。
INKNEST_ASSET_UPLOAD_URL_MINUTES=15

# 未完成上传会话的有效小时数。
INKNEST_ASSET_UPLOAD_SESSION_HOURS=24

# 预签名下载地址的有效分钟数。
INKNEST_ASSET_DOWNLOAD_URL_MINUTES=15

# 单个附件最大字节数；536870912 字节等于 512 MiB。
INKNEST_MAX_ASSET_UPLOAD_BYTES=536870912


# =============================================================================
# 5. 附件清理任务
# =============================================================================
# 过期但仍处于 pending 状态的上传，在清理前额外保留的小时数。
INKNEST_ASSET_CLEANUP_PENDING_GRACE_HOURS=24

# 已取消或已完成的暂存对象，在清理前额外保留的小时数。
INKNEST_ASSET_CLEANUP_STAGING_GRACE_HOURS=1

# 无数据库引用的最终对象进入隔离区后，等待多少天才允许删除。
INKNEST_ASSET_CLEANUP_ORPHAN_QUARANTINE_DAYS=7

# 每次清理任务最多处理的记录数。
INKNEST_ASSET_CLEANUP_BATCH_SIZE=100


# =============================================================================
# 6. JWT 与登录会话
# =============================================================================
# JWT 签名密钥，至少 32 个字符。不要提交真实值。
# 可运行 `openssl rand -hex 32` 生成，再把输出内容填写到 server/.env。
INKNEST_JWT_SECRET=replace-with-at-least-32-random-characters

# Access Token 的有效分钟数。
INKNEST_ACCESS_TOKEN_MINUTES=15

# Refresh Token 的有效天数。
INKNEST_REFRESH_TOKEN_DAYS=30


# =============================================================================
# 7. 登录限流
# =============================================================================
# 同一 IP + 同一邮箱在时间窗口内允许的失败次数。
INKNEST_LOGIN_RATE_LIMIT_ACCOUNT_ATTEMPTS=5

# 同一 IP 在时间窗口内允许的总失败次数。
INKNEST_LOGIN_RATE_LIMIT_IP_ATTEMPTS=25

# 登录失败统计窗口，单位为秒；300 秒等于 5 分钟。
INKNEST_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
