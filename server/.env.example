INKNEST_ENVIRONMENT=development
INKNEST_LOG_LEVEL=INFO
INKNEST_DATABASE_URL=postgresql+psycopg://inknest:inknest-postgres-dev@localhost:5432/inknest
INKNEST_MINIO_ENDPOINT=localhost:9000
INKNEST_MINIO_ACCESS_KEY=inknest-minio
INKNEST_MINIO_SECRET_KEY=inknest-minio-dev
INKNEST_MINIO_SECURE=false
INKNEST_MINIO_BUCKET=inknest-private
INKNEST_JWT_SECRET=replace-with-at-least-32-random-characters
INKNEST_ACCESS_TOKEN_MINUTES=15
INKNEST_REFRESH_TOKEN_DAYS=30
INKNEST_LOGIN_RATE_LIMIT_ACCOUNT_ATTEMPTS=5
INKNEST_LOGIN_RATE_LIMIT_IP_ATTEMPTS=25
INKNEST_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
