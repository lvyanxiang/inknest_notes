# Copy to .env.flutter and set the API origin reachable from your device.
# Do not commit .env.flutter.
#
# iOS Simulator / macOS desktop: http://127.0.0.1:8000
# Android emulator: http://10.0.2.2:8000
# Physical device: http://<your-lan-ip>:8000
#
# The value is only the origin; do not append /api/v1.
INKNEST_API_BASE_URL=http://127.0.0.1:8000
